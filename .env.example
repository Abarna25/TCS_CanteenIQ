# CanteenIQ Environment Configuration Example
# Copy to .env in backend/ or frontend/

# Backend FastAPI Configuration
API_PORT=8000
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend Next.js Configuration
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_DEMO_MODE=true

# Persistent Database (Supabase / PostgreSQL)
# Local development uses the included zero-dependency JSON/in-memory store by default
DATABASE_URL=postgresql://postgres:your-supabase-password@db.your-supabase-project.supabase.co:5432/postgres
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
